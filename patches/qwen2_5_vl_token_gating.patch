+class Qwen2_5_VLTokenScorer(nn.Module):
+    """Lightweight MLP that scores each (post-merger) video token for importance.
+
+    Matches the trained scorer checkpoint layout: ``inputNorm`` (LayerNorm) ->
+    ``mlp`` (Linear + GELU) -> ``head`` (Linear to a scalar). It operates on the
+    same merged video embeddings the model scatters into the ``<|video_pad|>``
+    positions, so a token's score is computed from exactly the feature that token
+    would contribute to the LLM.
+    """
+
+    def __init__(self, input_dim: int, hidden_dim: int = 256):
+        super().__init__()
+        self.input_dim = input_dim
+        self.inputNorm = nn.LayerNorm(input_dim)
+        self.mlp = nn.Sequential(nn.Linear(input_dim, hidden_dim), nn.GELU())
+        self.head = nn.Linear(hidden_dim, 1)
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        # x: (..., input_dim) -> scores: (...,)
+        return self.head(self.mlp(self.inputNorm(x))).squeeze(-1)
+
+
+def _einmahl_haan_gamma(scores: torch.Tensor, k_frac: float = 0.10) -> float:
+    """Sign-aware moment estimator of the EVT tail index gamma.
+
+    Returns ``gamma <= 0`` for a light/bounded upper tail (collapsing the budget
+    allocator to a uniform per-frame split) and ``NaN`` when there are too few
+    positive samples to estimate.
+    """
+    x = scores.flatten().float()
+    x = x[x > 0].sort().values
+    n = x.numel()
+    if n < 12:
+        return float("nan")
+    k = min(max(10, int(k_frac * n)), n - 1)
+    logs = torch.log(x[n - k :]) - torch.log(x[n - k - 1])
+    m1 = logs.mean()
+    m2 = (logs**2).mean()
+    return (m1 + 1.0 - 0.5 / (1.0 - m1**2 / m2)).item()
+
+
+def _pareto_budget(
+    scores: torch.Tensor, n_frames: int, k: int, k_min: int = 1, temp: float = 1.0, beta_max: float = 3.0
+) -> torch.Tensor:
+    """Per-frame token budgets (length ``n_frames``) summing to ``k``.
+
+    The split is a tempered power law of each frame's predicted-importance mass,
+    ``w_t ∝ m_t ** beta`` with ``beta = clamp(temp * gamma, 0, beta_max)`` and
+    ``gamma`` the Pareto tail index over all tokens. ``beta -> 0`` recovers a
+    uniform per-frame split; large ``beta`` approaches global top-k. The ``k_min``
+    floor guarantees temporal coverage; budgets are capped at the per-frame token
+    count and any overflow is redistributed so the result sums to ``k``.
+    """
+    n_video = scores.numel()
+    T = n_frames
+    N = n_video // T
+    k = int(min(k, n_video))
+    p = torch.softmax(scores.float(), dim=-1)
+    gamma = _einmahl_haan_gamma(p)
+    beta = 0.0 if gamma != gamma else max(0.0, min(temp * gamma, beta_max))
+    m = p.view(T, N).sum(dim=1)
+    w = m.pow(beta)
+    w = w / w.sum().clamp_min(1e-12)
+    k_min = max(0, min(k_min, k // T))
+    spendable = k - k_min * T
+    frac = spendable * w
+    k_t = k_min + frac.floor().long()
+    deficit = k - int(k_t.sum().item())
+    if deficit > 0:
+        top = torch.topk(frac - frac.floor(), min(deficit, T)).indices
+        k_t[top] += 1
+    k_t = k_t.clamp(max=N)
+    while True:
+        short = k - int(k_t.sum().item())
+        if short <= 0:
+            break
+        cand = torch.where(k_t < N)[0]
+        if cand.numel() == 0:
+            break
+        order = cand[torch.argsort(w[cand], descending=True)]
+        k_t[order[:short]] += 1
+    return k_t
+
+
+def _select_pareto_stratified(
+    scores: torch.Tensor, k: int, n_frames: int, k_min: int = 1, temp: float = 1.0, beta_max: float = 3.0
+) -> torch.Tensor:
+    """Indices (sorted ascending) of the video tokens kept under stratified
+    per-frame Pareto budgeting. Falls back to a global top-k when the tokens do
+    not divide evenly into ``n_frames`` temporal bins."""
+    n_video = scores.numel()
+    if n_frames <= 0 or n_video % n_frames != 0:
+        return torch.sort(torch.topk(scores, min(k, n_video)).indices).values
+    T = n_frames
+    N = n_video // T
+    budgets = _pareto_budget(scores, T, k, k_min=k_min, temp=temp, beta_max=beta_max)
+    kept = []
+    for t in range(T):
+        bt = int(budgets[t].item())
+        if bt == 0:
+            continue
+        offset = t * N
+        local = torch.topk(scores[offset : offset + N], k=bt).indices
+        kept.append(local + offset)
+    if not kept:
+        return torch.sort(torch.topk(scores, min(k, n_video)).indices).values
+    return torch.sort(torch.cat(kept)).values
+
